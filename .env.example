# Server
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bookleaf_authorcare?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change_this_to_a_secure_cookie_secret
CLIENT_URL=http://localhost:5173

# Demo credentials seeding
ADMIN_EMAIL=admin@bookleaf.test
ADMIN_PASSWORD=Admin@123
DEMO_AUTHOR_PASSWORD=Author@123

# Optional: require a key to register as admin (leave empty to allow open admin registration in development)
ADMIN_REGISTRATION_KEY=

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_ENABLED=true
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2

# Optional: Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
