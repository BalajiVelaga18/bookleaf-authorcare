{
  "name": "bookleaf-authorcare",
  "version": "1.0.0",
  "description": "BookLeaf AuthorCare — Intelligent Author Support Portal",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm run install:client && npm run install:server",
    "install:client": "npm install --prefix client",
    "install:server": "npm install --prefix server",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build --prefix client",
    "test": "npm run test --prefix server && npm run test --prefix client",
    "test:server": "npm run test --prefix server",
    "seed": "npm run seed --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": ["bookleaf", "author", "support", "tickets", "gemini", "ai"],
  "license": "UNLICENSED"
}
